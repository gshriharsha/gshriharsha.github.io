---
import { Icon } from 'astro-icon/components';
import { certifications } from '../data/certifications';

const anthropicCerts = certifications.filter(c => c.organization === 'Anthropic');
const salesforceCerts = certifications.filter(c => !c.organization || c.organization === 'Salesforce');
---
<section id="certifications" class="border-t border-[color:var(--color-border)]">
  <div class="mx-auto w-full max-w-[var(--max-content)] px-4 py-20 sm:px-6 lg:px-8">
    <div class="reveal mb-12 flex flex-col gap-3">
      <p class="text-sm font-medium uppercase tracking-widest text-[color:var(--color-accent)]">Certifications</p>
      <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">{certifications.length}× Certified</h2>
      <p class="max-w-[var(--max-prose)] text-base text-[color:var(--color-text-muted)] sm:text-lg">
        {salesforceCerts.length}× Salesforce Certified.
        {anthropicCerts.length > 0 && `${anthropicCerts.length}× Anthropic Certified·`}
      </p>
    </div>

    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {certifications.map((cert) => (
        <li class="reveal group flex items-start gap-4 rounded-2xl border border-[color:var(--color-border)] bg-[color:var(--color-surface)] p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
          {cert.logo ? (
            <img src={cert.logo} alt={cert.name} class="h-14 w-14 flex-shrink-0 object-contain" loading="lazy" />
          ) : (
            <span class="grid h-14 w-14 flex-shrink-0 place-items-center rounded-xl bg-[color:var(--color-accent-soft)] text-[color:var(--color-accent)]">
              <Icon name="lucide:award" class="h-6 w-6" aria-hidden="true" />
            </span>
          )}
          <div class="flex-1">
            <h3 class="text-sm font-semibold text-[color:var(--color-text)]">
              {cert.url ? (
                <a href={cert.url} target="_blank" rel="noopener noreferrer" class="hover:text-[color:var(--color-accent)] transition-colors inline-flex items-center gap-1">
                  {cert.short} <Icon name="lucide:external-link" class="h-3 w-3" />
                </a>
              ) : (
                cert.short
              )}
            </h3>
            <p class="mt-1 text-xs text-[color:var(--color-text-muted)]">{cert.name}</p>
            <div class="mt-2 flex flex-wrap items-center gap-2">
              <span class="inline-flex rounded-full bg-[color:var(--color-bg)] px-2 py-0.5 text-[10px] font-medium uppercase tracking-widest text-[color:var(--color-text-subtle)]">{cert.category}</span>
              {cert.issued && (
                <span class="text-[10px] text-[color:var(--color-text-muted)]">Issued {cert.issued}</span>
              )}
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
